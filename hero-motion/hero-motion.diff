@@ -57,3 +69,90 @@ import LogoCarousel from "./LogoCarousel";
     <LogoCarousel client:visible speed={100} logoHeight={45} gap={60} className="mx-auto" />
   </div>
 </section>
+
+<style>
+  /* Sunrise to sunset. The script sets three numbers on the section:
+     --hero-sink    0 → 1, fast at first then settling (drives the drift)
+     --hero-golden  0 → 1 over the first half of the day (eased)
+     --hero-dusk    0 → 1 over the second half (eased)
+     Without the script all three stay 0 and the hero looks exactly as before. */
+  .hero-sky {
+    mask-image: linear-gradient(to bottom, #000 75%, transparent);
+  }
+  /* The sky holds still as the page starts to move, then eases back into the
+     scroll, so the sun lingers on screen long enough to set. */
+  .hero-sky__drift {
+    transform: translate3d(0, calc(var(--hero-sink, 0) * 25%), 0);
+    will-change: transform;
+  }
+  .hero-sky__golden {
+    opacity: var(--hero-golden, 0);
+    will-change: opacity;
+  }
+  .hero-sky__dusk {
+    opacity: var(--hero-dusk, 0);
+    will-change: opacity;
+  }
+
+  /* Same peak opacity as the original glow (opacity-30 md:opacity-40), scaled by the phase. */
+  .hero-glow {
+    --hero-glow-max: 0.3;
+    will-change: opacity;
+  }
+  @media (min-width: 48rem) {
+    .hero-glow {
+      --hero-glow-max: 0.4;
+    }
+  }
+  .hero-glow--golden {
+    opacity: calc(var(--hero-glow-max) * var(--hero-golden, 0));
+  }
+  .hero-glow--dusk {
+    opacity: calc(var(--hero-glow-max) * var(--hero-dusk, 0));
+  }
+
+  /* Keep the colour change, drop the movement. */
+  @media (prefers-reduced-motion: reduce) {
+    .hero-sky__drift {
+      transform: none;
+    }
+  }
+</style>
+
+<script>
+  // The day passes while the hero scrolls through the first RANGE of its own height.
+  // The sky drifts down by RANGE / 2 of that height (the 25% in the CSS), which
+  // starts it at a standstill and hands it back to the page at full speed.
+  const RANGE = 0.5;
+
+  const clamp01 = (x: number) => Math.min(Math.max(x, 0), 1);
+  const smoothstep = (from: number, to: number, x: number) => {
+    const t = clamp01((x - from) / (to - from));
+    return t * t * (3 - 2 * t);
+  };
+
+  document.querySelectorAll<HTMLElement>("[data-hero-motion]").forEach((hero) => {
+    let queued = false;
+    let last = -1;
+
+    const update = () => {
+      queued = false;
+      const { top, height } = hero.getBoundingClientRect();
+      const p = clamp01(-top / (height * RANGE));
+      if (p === last) return;
+      last = p;
+      hero.style.setProperty("--hero-sink", (1 - (1 - p) ** 2).toFixed(4));
+      hero.style.setProperty("--hero-golden", smoothstep(0, 0.6, p).toFixed(4));
+      hero.style.setProperty("--hero-dusk", smoothstep(0.4, 1, p).toFixed(4));
+    };
+    const queue = () => {
+      if (queued) return;
+      queued = true;
+      requestAnimationFrame(update);
+    };
+
+    addEventListener("scroll", queue, { passive: true });
+    addEventListener("resize", queue);
+    update();
+  });
+</script>
