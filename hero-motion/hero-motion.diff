     <div
@@ -20,6 +22,16 @@ import LogoCarousel from "./LogoCarousel";
       style="background: radial-gradient(ellipse, #A5BBFC 0%, #D5E2FF 40%, transparent 70%);"
       aria-hidden="true"
     ></div>
+    <div
+      class="hero-glow hero-glow--golden top-1/2 left-1/2 -z-10 absolute blur-[80px] md:blur-[100px] w-72 md:w-[600px] h-72 md:h-[400px] -translate-x-1/2 -translate-y-1/2 pointer-events-none"
